{
  "entities": {
    "PrintOrder": {
      "title": "PrintOrder",
      "description": "Surat Perintah Kerja (SPK) dan nota transaksi pesanan cetak digital printing beserta perhitungan HPP dan piutang pelanggan.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID pemilik usaha digital printing.",
          "minLength": 1,
          "maxLength": 128
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Nomor nota atau SPK pesanan cetak.",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[A-Z0-9\\-/]+$"
        },
        "orderDate": {
          "type": "string",
          "description": "Tanggal masuk pesanan (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "deadlineDate": {
          "type": "string",
          "description": "Tanggal estimasi selesai atau deadline produksi (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "customerName": {
          "type": "string",
          "description": "Nama pelanggan atau instansi pemesan.",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "description": "Nomor WhatsApp atau telepon pelanggan.",
          "minLength": 0,
          "maxLength": 30
        },
        "jobTitle": {
          "type": "string",
          "description": "Nama pekerjaan atau judul file cetak.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Kategori lini layanan cetak, penjualan ATK, atau jasa.",
          "enum": [
            "Banner & Outdoor",
            "Indoor & Sticker",
            "Print A3+ & Dokumen",
            "Merchandise & Display",
            "Offset & Kemasan",
            "Fotokopi, Jilid & Laminating",
            "Penjualan ATK",
            "Jasa Desain & Servis IT"
          ]
        },
        "materialId": {
          "type": "string",
          "description": "ID referensi bahan baku di koleksi inventory.",
          "minLength": 1,
          "maxLength": 128
        },
        "materialName": {
          "type": "string",
          "description": "Nama bahan baku yang digunakan.",
          "minLength": 1,
          "maxLength": 120
        },
        "unitType": {
          "type": "string",
          "description": "Satuan perhitungan ukuran atau kuantitas.",
          "enum": [
            "m2",
            "Lembar",
            "Roll",
            "Pcs",
            "Paket"
          ]
        },
        "widthM": {
          "type": "number",
          "description": "Ukuran panjang/lebar dalam meter (untuk satuan m2)."
        },
        "heightM": {
          "type": "number",
          "description": "Ukuran tinggi dalam meter (untuk satuan m2)."
        },
        "qty": {
          "type": "number",
          "description": "Jumlah pcs/lembar pesanan."
        },
        "totalAreaOrQty": {
          "type": "number",
          "description": "Total volume pemakaian bahan (m2 x qty atau jumlah lembar/pcs)."
        },
        "unitPrice": {
          "type": "number",
          "description": "Harga jual per satuan (per m2 / per lembar / per pcs)."
        },
        "unitCost": {
          "type": "number",
          "description": "Harga pokok bahan & tinta per satuan."
        },
        "designFee": {
          "type": "number",
          "description": "Biaya jasa setting atau desain grafis."
        },
        "finishingDesc": {
          "type": "string",
          "description": "Rincian pengerjaan finishing (Mata ayam, laminasi, lipat, potong).",
          "minLength": 0,
          "maxLength": 160
        },
        "finishingFee": {
          "type": "number",
          "description": "Biaya tambahan finishing."
        },
        "discount": {
          "type": "number",
          "description": "Potongan harga atau diskon pesanan."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total tagihan akhir pelanggan."
        },
        "totalCogs": {
          "type": "number",
          "description": "Total Harga Pokok Produksi (HPP) untuk pesanan ini."
        },
        "paidAmount": {
          "type": "number",
          "description": "Jumlah yang sudah dibayarkan pelanggan (DP atau Lunas)."
        },
        "paymentStatus": {
          "type": "string",
          "description": "Status pembayaran tagihan pesanan.",
          "enum": [
            "Lunas",
            "DP / Belum Lunas",
            "Belum Bayar"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "description": "Metode pembayaran yang digunakan.",
          "enum": [
            "Tunai",
            "Transfer Bank",
            "QRIS",
            "Tempo"
          ]
        },
        "productionStatus": {
          "type": "string",
          "description": "Status tahapan produksi SPK.",
          "enum": [
            "Antrean Desain",
            "Proses Cetak",
            "Finishing",
            "Siap Ambil",
            "Selesai",
            "Dibatalkan"
          ]
        },
        "notes": {
          "type": "string",
          "description": "Catatan spesifikasi produksi untuk operator.",
          "minLength": 0,
          "maxLength": 300
        },
        "cashierName": {
          "type": "string",
          "description": "Nama kasir atau admin yang melayani dan menyimpan transaksi SPK.",
          "minLength": 0,
          "maxLength": 80
        },
        "cartItemsJson": {
          "type": "string",
          "description": "JSON rincian daftar item keranjang pesanan apabila 1 nota/SPK terdiri dari beberapa produk berbeda.",
          "minLength": 0,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembuatan dokumen."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pembaruan dokumen terakhir."
        }
      },
      "required": [
        "ownerId",
        "invoiceNumber",
        "orderDate",
        "deadlineDate",
        "customerName",
        "customerPhone",
        "jobTitle",
        "category",
        "materialId",
        "materialName",
        "unitType",
        "widthM",
        "heightM",
        "qty",
        "totalAreaOrQty",
        "unitPrice",
        "unitCost",
        "designFee",
        "finishingDesc",
        "finishingFee",
        "discount",
        "totalAmount",
        "totalCogs",
        "paidAmount",
        "paymentStatus",
        "paymentMethod",
        "productionStatus",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
