    "RemoteCameraSession": {
      "title": "RemoteCameraSession",
      "description": "Sesi real-time penghubung kamera scanner ponsel eksternal (QR Auto-Connect) ke keranjang POS Web Desktop.",
      "type": "object",
      "properties": {
        "sessionCode": {
          "type": "string",
          "description": "Kode sesi 6 digit kasir desktop.",
          "minLength": 1,
          "maxLength": 32
        },
        "msgId": {
          "type": "string",
          "description": "ID unik pesan scan atau handshake.",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "type": "string",
          "description": "Jenis pesan relay kamera ponsel.",
          "enum": [
            "SCAN",
            "ADJUST_DELTA",
            "REMOVE_SKU",
            "HELLO",
            "ACK"
          ]
        },
        "sku": {
          "type": "string",
          "description": "Kode SKU / Barcode produk yang dipindai.",
          "minLength": 0,
          "maxLength": 64
        },
        "deltaQty": {
          "type": "number",
          "description": "Perubahan kuantitas barang."
        },
        "sendMode": {
          "type": "string",
          "description": "Mode pengiriman data scan dari ponsel ke desktop.",
          "enum": [
            "AUTO_SEND",
            "MANUAL_SEND"
          ]
        },
        "deviceName": {
